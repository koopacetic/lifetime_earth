#!/usr/bin/env bash
# The Lifetime of the Earth: common commands. Every tool also runs directly:
#   .venv/bin/python tools/<x>.py --help
set -euo pipefail
cd "$(dirname "$0")"
PY=.venv/bin/python
cmd=${1:-help}; shift || true
case "$cmd" in
  setup)    python3 -m venv .venv && $PY -m pip install -q -r requirements.txt ;;
  check)    $PY tools/check.py "$@" ;;
  demo)     $PY tools/build.py --demo "$@" ;;
  pages)    $PY tools/build.py --pages "${1:-1-15}" "${@:2}" ;;
  png)      $PY tools/build.py --pages "${1:-1-15}" --png "${@:2}" ;;
  book)     $PY tools/build.py "$@" ;;
  art)      $PY tools/art.py "$@" ;;
  sketches) $PY docs/sketches/front_diagrams.py ;;
  fullness) $PY tools/fullness.py "$@" ;;
  query)    $PY tools/query.py "$@" ;;
  add)      $PY tools/add.py "$@" ;;
  fmt)      $PY tools/add.py --fmt ;;
  clean)    rm -rf build/* ;;
  *) cat <<'H'
./run setup              create .venv, install requirements
./run check              validate all data
./run demo               config demo_pages            -> build/demo.pdf
./run pages 1-15         content page range           -> build/partial.pdf
./run png 901            render pages to build/png/   (visual check)
./run book               full book                    -> build/book.pdf
./run art search NAME | fetch UUID SLUG | outline FILE   (PhyloPic pipeline)
./run sketches           front-of-book diagram ideas  -> docs/sketches/
./run fullness           fullness report              -> build/fullness.{md,png}
./run query --page 901   look up data (see --help)
./run add FILE < new.json   add events, sort, validate
./run fmt                sort + canonically format event files
H
  ;;
esac
